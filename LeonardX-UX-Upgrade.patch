+import Link from 'next/link';
+import { ArrowLeftRight, ArrowRight, Code2, KeyRound, ShieldCheck, Webhook, CircleAlert, Gauge } from 'lucide-react';
+import { LEOAppShell, Panel } from '@/components/LEOAppShell';
+
+const currentControls = [
+  'API keys are scoped, revocable, and can have an expiry date.',
+  'Requests are authenticated by the existing API-key gateway.',
+  'Rate limits and supported operations are enforced by server policy.',
+  'Usage endpoints and request identifiers are available where supported by the current API.',
+];
+
+export const metadata = {
+  title: 'Developer API Plans | LeonardX',
+  description: 'Developer API access and billing status, separate from Leo AI subscriptions.',
+};
+
+export default function DeveloperPricingPage() {
+  return (
+    <LEOAppShell title="Developer API plans" subtitle="API access and billing are separate from Leo AI subscriptions.">
+      <section className="page-hero">
+        <span className="mini-label">DEVELOPER PLATFORM / BILLING</span>
+        <h2>Choose how your software connects to LeonardX.</h2>
+        <p>Developer API plans are a separate product from Leo AI chat, image/video credits, website-building subscriptions, and hosting. This page shows only verified availability; paid API prices and quotas are not published until they are configured and approved.</p>
+        <div className="hero-actions">
+          <Link href="/api-keys" className="primary-button"><KeyRound size={14}/> Manage API keys <ArrowRight size={13}/></Link>
+          <Link href="/docs/api" className="secondary-button"><Code2 size={14}/> API documentation</Link>
+          <Link href="/pricing" className="secondary-button"><ArrowLeftRight size={14}/> Leo AI plans</Link>
+        </div>
+      </section>
+
+      <div className="mt-4 grid gap-3 lg:grid-cols-3">
+        <Panel className="flex flex-col">
+          <span className="mini-label">CURRENT API ACCESS</span>
+          <h3 className="mt-2 text-xl font-bold">Developer access</h3>
+          <p className="mt-2 text-sm text-zinc-400">Use the existing API surface with a valid key and the scopes supported by each endpoint.</p>
+          <div className="mt-5 rounded-xl border border-white/10 bg-white/[.03] p-3"><p className="text-xs text-zinc-400">Published API subscription price</p><p className="mt-1 text-lg font-bold">Not configured</p><p className="mt-1 text-xs text-zinc-500">No separate paid amount is asserted here.</p></div>
+          <ul className="mt-5 space-y-3 text-sm text-zinc-300">{currentControls.map(item => <li key={item} className="flex gap-2"><ShieldCheck size={16} className="mt-0.5 shrink-0 text-emerald-300"/><span>{item}</span></li>)}</ul>
+          <Link href="/api-keys" className="secondary-button mt-6 justify-center">Open API keys <ArrowRight size={13}/></Link>
+        </Panel>
+
+        <Panel className="flex flex-col">
+          <span className="mini-label">PROPOSED EXTENSION</span>
+          <h3 className="mt-2 text-xl font-bold">Paid API tiers</h3>
+          <p className="mt-2 text-sm text-zinc-400">Higher quotas, optional model access, and overage rules require approved commercial terms and independent server-side entitlement enforcement.</p>
+          <div className="mt-5 rounded-xl border border-amber-200/15 bg-amber-200/[.04] p-3"><p className="text-xs text-amber-100">Status</p><p className="mt-1 text-lg font-bold">Pending approval</p><p className="mt-1 text-xs text-zinc-500">Price, quota, and overage policy are intentionally unpublished.</p></div>
+          <div className="mt-5 flex gap-3 text-sm text-zinc-400"><Gauge size={17} className="mt-0.5 shrink-0"/><p>There is no checkout action for a paid API tier until its limits, price, billing lifecycle, and usage metering are implemented and verified.</p></div>
+        </Panel>
+
+        <Panel className="flex flex-col">
+          <span className="mini-label">ENTERPRISE EXTENSION</span>
+          <h3 className="mt-2 text-xl font-bold">Enterprise API</h3>
+          <p className="mt-2 text-sm text-zinc-400">An extension point for organization-level access, usage commitments, and support arrangements. It is not currently a purchasable plan.</p>
+          <div className="mt-5 rounded-xl border border-white/10 bg-white/[.03] p-3"><p className="text-xs text-zinc-400">Availability</p><p className="mt-1 text-lg font-bold">Not enabled</p><p className="mt-1 text-xs text-zinc-500">No enterprise entitlement or price is implied by this page.</p></div>
+          <Link href="/support" className="secondary-button mt-6 justify-center"><Webhook size={14}/> Ask support about API access</Link>
+        </Panel>
+      </div>
+
+      <Panel className="mt-4">
+        <div className="flex items-start gap-3"><CircleAlert size={19} className="mt-0.5 shrink-0 text-amber-200"/><div><h3 className="panel-title">Billing separation and current limits</h3><p className="mt-2 text-sm leading-6 text-zinc-400">Leo AI subscriptions are priced on <Link href="/pricing" className="text-amber-100 underline underline-offset-4">the Leo AI pricing page</Link>. They do not automatically grant a paid Developer API plan. Website hosting is also separate. Current API request limits remain governed by the deployed API gateway; exact numeric quotas are not shown here because they have not been verified as a public pricing contract.</p></div></div>
+      </Panel>
+    </LEOAppShell>
+  );
+}
--- a/tests/workspace-navigation.test.mjs
+++ b/tests/workspace-navigation.test.mjs
@@ -0,0 +1,30 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+
+const root = new URL('../', import.meta.url);
+const read = (path) => readFile(new URL(path, root), 'utf8');
+
+test('workspace sidebar keeps public marketing pages out of the product navigation', async () => {
+  const shell = await read('components/LEOAppShell.tsx');
+  assert.match(shell, /\[\.\.\.groups, \.\.\.\(isOwner \? \[adminGroup\] : \[\]\)\]/);
+  assert.doesNotMatch(shell, /\[\.\.\.groups, publicGroup, \.\.\.\(isOwner \? \[adminGroup\] : \[\]\)\]/);
+  assert.match(shell, /\['API plans','\/developers\/pricing',Wallet\]/);
+});
+
+test('nested workspace routes select the most specific navigation item', async () => {
+  const shell = await read('components/LEOAppShell.tsx');
+  assert.match(shell, /\.sort\(\(a, b\) => b\.length - a\.length\)\[0\]/);
+  assert.match(shell, /const active = href === activeHref/);
+});
+
+test('Developer API pricing is separate and does not invent paid prices', async () => {
+  const apiPricing = await read('app/developers/pricing/page.tsx');
+  const leoPricing = await read('app/pricing/page.tsx');
+  assert.match(apiPricing, /paid API prices and quotas are not published/i);
+  assert.match(apiPricing, /Pending approval/);
+  assert.match(apiPricing, /href="\/pricing"/);
+  assert.match(leoPricing, /Developer API billing is separate/);
+  assert.match(leoPricing, /href="\/developers\/pricing"/);
+  assert.doesNotMatch(apiPricing, /\$\s?\d|₦\s?\d|\d+\s?USD/i);
+});
