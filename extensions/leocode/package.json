{
  "name": "leocode",
  "publisher": "leonardx",
  "displayName": "Bram Code by Braverton",
  "description": "Independent Braverton AI coding model for VS Code Chat, with account-based API billing and workspace-aware coding tools.",
  "version": "0.1.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "Bram Code",
    "Bram",
    "Braverton",
    "AI coding model",
    "VS Code model provider"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:leocode.chat",
    "onCommand:leocode.openChat",
    "onCommand:leocode.connect",
    "onCommand:leocode.explainSelection",
    "onCommand:leocode.reviewFile",
    "onCommand:leocode.fixSelection",
    "onCommand:leocode.generateCode",
    "onCommand:leocode.analyzeWorkspace",
    "onCommand:leocode.generateTests",
    "onCommand:leocode.runAgent",
    "onCommand:leocode.applyGeneratedCode",
    "onCommand:leocode.runCommand",
    "onCommand:leocode.viewUsage",
    "onCommand:leocode.signOut",
    "onCommand:leocode.reviewSelection",
    "onCommand:leocode.reviewWorkspace",
    "onCommand:leocode.reviewGitChanges",
    "onCommand:leocode.openReviewCentre",
    "onCommand:leocode.coordinateAgents",
    "onCommand:leocode.runTests",
    "onCommand:leocode.inspectGit"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "leocode_list_mcp_tools",
        "toolReferenceName": "listLeonardXMcpTools",
        "displayName": "List LeonardX MCP Tools",
        "modelDescription": "Lists the signed-in user's LeonardX MCP connections and their existing approval status.",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "leocode_call_mcp_tool",
        "toolReferenceName": "callLeonardXMcpTool",
        "displayName": "Call LeonardX MCP Tool",
        "modelDescription": "Calls a LeonardX MCP tool that is already enabled and approved for the signed-in account. The user must confirm the call.",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "toolName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "serverId",
            "toolName",
            "arguments"
          ],
          "additionalProperties": false
        }
      }
    ],
    "configuration": {
      "title": "Bram Code",
      "properties": {
        "leocode.baseUrl": {
          "type": "string",
          "default": "https://leoos-omega.vercel.app",
          "description": "Braverton server origin. HTTPS is required except for local development."
        },
        "leocode.projectId": {
          "type": "string",
          "default": "",
          "description": "Optional Braverton project UUID for project-aware features."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leocode",
          "title": "Bram Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "leocode": [
        {
          "id": "leocode.chat",
          "name": "Bram Code",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "leocode.configureModel",
        "title": "Bram Code: Configure Braverton API"
      },
      {
        "command": "leocode.startAgentHost",
        "title": "LeoCode: Start Local Agent Host"
      },
      {
        "command": "leocode.stopAgentHost",
        "title": "LeoCode: Stop Local Agent Host"
      },
      {
        "command": "leocode.openChat",
        "title": "LeoCode: Open Chat"
      },
      {
        "command": "leocode.connect",
        "title": "LeoCode: Connect LeonardX"
      },
      {
        "command": "leocode.explainSelection",
        "title": "LeoCode: Explain Selected Code"
      },
      {
        "command": "leocode.reviewFile",
        "title": "LeoCode: Review Current File"
      },
      {
        "command": "leocode.fixSelection",
        "title": "LeoCode: Fix Selected Code"
      },
      {
        "command": "leocode.generateCode",
        "title": "LeoCode: Generate Code"
      },
      {
        "command": "leocode.analyzeWorkspace",
        "title": "LeoCode: Analyze Workspace"
      },
      {
        "command": "leocode.generateTests",
        "title": "LeoCode: Generate Tests"
      },
      {
        "command": "leocode.runAgent",
        "title": "LeoCode: Run Specialist Agent"
      },
      {
        "command": "leocode.applyGeneratedCode",
        "title": "LeoCode: Apply Generated Code"
      },
      {
        "command": "leocode.runCommand",
        "title": "LeoCode: Run Approved Terminal Command"
      },
      {
        "command": "leocode.viewUsage",
        "title": "LeoCode: View Usage"
      },
      {
        "command": "leocode.signOut",
        "title": "LeoCode: Sign Out"
      },
      {
        "command": "leocode.reviewSelection",
        "title": "LeoCode: Review Selected Code"
      },
      {
        "command": "leocode.reviewWorkspace",
        "title": "LeoCode: Review Entire Workspace"
      },
      {
        "command": "leocode.reviewGitChanges",
        "title": "LeoCode: Review Git Changes"
      },
      {
        "command": "leocode.openReviewCentre",
        "title": "LeoCode: Open Code Review Centre"
      },
      {
        "command": "leocode.coordinateAgents",
        "title": "LeoCode: Coordinate Specialist Agents"
      },
      {
        "command": "leocode.runTests",
        "title": "LeoCode: Discover and Run Tests"
      },
      {
        "command": "leocode.inspectGit",
        "title": "LeoCode: Inspect Git Status"
      },
      {
        "command": "leocode.runHostedWorkspace",
        "title": "LeoCode: Run on Private GitHub Runtime"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "braverton-bram-code",
        "displayName": "Bram Code",
        "managementCommand": "leocode.configureModel"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "@ahpd/agent-cofold": "0.14.0",
    "@ahpd/sdk": "0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
