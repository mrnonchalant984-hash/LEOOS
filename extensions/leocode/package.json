{
  "name": "leocode",
  "publisher": "leonardx",
  "displayName": "Bram Code by Braverton",
  "description": "Independent Braverton AI coding model for VS Code Chat, with account-based API billing and workspace-aware coding tools.",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "Bram Code",
    "Bram",
    "Braverton",
    "AI coding model",
    "VS Code model provider"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:leocode.chat",
    "onCommand:leocode.openChat",
    "onCommand:leocode.connect",
    "onCommand:leocode.explainSelection",
    "onCommand:leocode.reviewFile",
    "onCommand:leocode.fixSelection",
    "onCommand:leocode.generateCode",
    "onCommand:leocode.analyzeWorkspace",
    "onCommand:leocode.generateTests",
    "onCommand:leocode.applyGeneratedCode",
    "onCommand:leocode.runCommand",
    "onCommand:leocode.viewUsage",
    "onCommand:leocode.signOut",
    "onCommand:leocode.reviewSelection",
    "onCommand:leocode.reviewWorkspace",
    "onCommand:leocode.reviewGitChanges",
    "onCommand:leocode.openReviewCentre",
    "onCommand:leocode.runTests",
    "onCommand:leocode.inspectGit",
    "onCommand:leocode.configureModel",
    "onCommand:leocode.toggleInlineCompletions",
    "onCommand:leocode.runHostedWorkspace"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "leocode_list_mcp_tools",
        "toolReferenceName": "listBravertonMcpTools",
        "displayName": "List Braverton MCP Tools",
        "modelDescription": "Lists the signed-in user's Braverton MCP connections and their existing approval status.",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "leocode_call_mcp_tool",
        "toolReferenceName": "callBravertonMcpTool",
        "displayName": "Call Braverton MCP Tool",
        "modelDescription": "Calls a Braverton MCP tool that is already enabled and approved for the signed-in account. The user must confirm the call.",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "toolName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "serverId",
            "toolName",
            "arguments"
          ],
          "additionalProperties": false
        }
      }
    ],
    "configuration": {
      "title": "Bram Code",
      "properties": {
        "leocode.baseUrl": {
          "type": "string",
          "default": "https://leoos-omega.vercel.app",
          "description": "Braverton server origin. HTTPS is required except for local development."
        },
        "leocode.projectId": {
          "type": "string",
          "default": "",
          "description": "Optional Braverton project UUID for project-aware features."
        },
        "leocode.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "description": "Braverton Developer API model used for Bram Code and inline completions."
        },
        "leocode.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in Bram Code inline code suggestions. Each request uses your Braverton Developer API key and is billable under your active API plan."
        },
        "leocode.inlineCompletions.minimumIntervalMs": {
          "type": "number",
          "default": 1200,
          "minimum": 500,
          "maximum": 10000,
          "description": "Minimum delay between inline-completion API requests, in milliseconds."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leocode",
          "title": "Bram Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "leocode": [
        {
          "id": "leocode.chat",
          "name": "Bram Code",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "leocode.configureModel",
        "title": "Bram Code: Configure Braverton API"
      },
      {
        "command": "leocode.openChat",
        "title": "Bram Code: Open Chat"
      },
      {
        "command": "leocode.connect",
        "title": "Bram Code: Connect Braverton"
      },
      {
        "command": "leocode.explainSelection",
        "title": "Bram Code: Explain Selected Code"
      },
      {
        "command": "leocode.reviewFile",
        "title": "Bram Code: Review Current File"
      },
      {
        "command": "leocode.fixSelection",
        "title": "Bram Code: Fix Selected Code"
      },
      {
        "command": "leocode.generateCode",
        "title": "Bram Code: Generate Code"
      },
      {
        "command": "leocode.analyzeWorkspace",
        "title": "Bram Code: Analyze Workspace"
      },
      {
        "command": "leocode.generateTests",
        "title": "Bram Code: Generate Tests"
      },
      {
        "command": "leocode.applyGeneratedCode",
        "title": "Bram Code: Apply Generated Code"
      },
      {
        "command": "leocode.runCommand",
        "title": "Bram Code: Run Approved Terminal Command"
      },
      {
        "command": "leocode.viewUsage",
        "title": "Bram Code: View Usage"
      },
      {
        "command": "leocode.signOut",
        "title": "Bram Code: Sign Out"
      },
      {
        "command": "leocode.reviewSelection",
        "title": "Bram Code: Review Selected Code"
      },
      {
        "command": "leocode.reviewWorkspace",
        "title": "Bram Code: Review Entire Workspace"
      },
      {
        "command": "leocode.reviewGitChanges",
        "title": "Bram Code: Review Git Changes"
      },
      {
        "command": "leocode.openReviewCentre",
        "title": "Bram Code: Open Code Review Centre"
      },
      {
        "command": "leocode.runTests",
        "title": "Bram Code: Discover and Run Tests"
      },
      {
        "command": "leocode.inspectGit",
        "title": "Bram Code: Inspect Git Status"
      },
      {
        "command": "leocode.toggleInlineCompletions",
        "title": "Bram Code: Toggle Inline Completions"
      },
      {
        "command": "leocode.runHostedWorkspace",
        "title": "Bram Code: Run Hosted Workspace Check"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "braverton-bram-code",
        "displayName": "Bram Code",
        "managementCommand": "leocode.configureModel"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
