# OpenAI hosted Agents API computer/browser runtime
LEO_COMPUTER_USE_MODEL=gpt-6-astra
LEO_COMPUTER_USE_ENABLED=true
LEO_COMPUTER_USE_MAX_STEPS=30
# No separate browser URL/key is required when using OpenAI-hosted Agents API.
# It uses OPENAI_API_KEY server-side and the OpenAI Agents Sessions API.
# Optional informational endpoint:
LEO_COMPUTER_USE_API_URL=https://api.openai.com/v1/agents/sessions

