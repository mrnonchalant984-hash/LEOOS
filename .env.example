# Copy to .env.local for local development. Never commit real credentials.
# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LIVE_LEONARDX_URL=
NEXT_PUBLIC_LIVE_QVELI_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials — never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
LEO_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional server-side allowlisted model IDs are exposed through /api/models only when configured.
LEO_CHAT_MODEL=
LEO_API_URL=
LEO_AGENT_MODEL=
# Optional allowlist for the Developer API; only models with verified billing rates are exposed.
LEONARDX_API_MODELS=gpt-4o-mini
LEO_MEETING_MODEL=gpt-4o-mini
# Optional: endpoint for a locally managed OpenAI-compatible text model.
# For Ollama on the same computer: http://127.0.0.1:11434/v1
# Download a model once, e.g. qwen2.5:3b; see docs/OFFLINE-LOCAL-MODEL-SETUP.md.
LEO_LOCAL_MODEL_URL=
LEO_LOCAL_MODEL_API_KEY=
LEO_LOCAL_MODEL_NAME=
# true disables hosted provider fallback; requires local model URL and a locally hosted app
LEO_OFFLINE_MODE=false
LEO_MODEL_TIMEOUT_MS=45000
LEO_REASONING_MODEL=
LEO_RESEARCH_MODEL=
LEO_IMAGE_MODEL=
LEO_REALTIME_MODEL=
LEO_COMPUTER_USE_MODEL=

# Inbound MCP OAuth. Use the HTTPS origin only (for example https://leoos-omega.vercel.app).
# MCP_ALLOWED_ORIGINS is for browser clients that send Origin; list exact HTTPS origins,
# comma-separated, with no paths. Leave blank for server-to-server clients.
MCP_PUBLIC_URL=
MCP_ALLOWED_ORIGINS=
# Outbound MCP requires exact public hostnames (comma-separated, no scheme or path).
MCP_OUTBOUND_ALLOWED_HOSTS=
# Required to store optional remote MCP bearer credentials; use a random 32-byte key in base64 or 64-char hex.
MCP_CREDENTIAL_ENCRYPTION_KEY=

# Optional integrations
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=
# New, tenant-scoped SaaS deployments admitted per account in one hour (1–100).
LEO_BUILD_DEPLOY_LIMIT_PER_HOUR=3
# Expo/EAS token is server-only. Each saved mobile project also needs an
# app.json/app.config.js with extra.eas.projectId linked in Expo.
EXPO_TOKEN=
# Mobile/game access is disabled until the owner approves eligible tiers.
# Standard is always excluded. Values may be pro,business; no new price is implied.
LEONARDX_MOBILE_APP_PLANS=
LEONARDX_GAME_PLANS=
# Godot API origin must be the real private service's HTTPS URL after deployment.
GODOT_BUILD_SERVICE_URL=
GODOT_BUILD_SERVICE_TOKEN=
# Durable native Android queue worker. Protect the endpoint and call it from a trusted scheduler.
ANDROID_BUILD_WORKER_ENABLED=false
ANDROID_BUILD_WORKER_SECRET=
# GODOT_EXPORT_PRESETS is configured on the worker host, not in LeonardX/Vercel.
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
# Optional SMTP delivery (TLS is mandatory; port 465 implicit TLS or 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=
# Platform credits charged per second of generated video. Configure only after validating provider pricing.
# This is NOT the same unit as Runway provider credits.
RUNWAY_GEN45_PLATFORM_CREDITS_PER_SECOND=
LEO_IMAGE_PLATFORM_CREDITS=

# Worker and webhook secrets: use long random values in deployment.
WORKFLOW_WORKER_ENABLED=false
WORKFLOW_WORKER_SECRET=
AGENT_WORKER_ENABLED=false
WORKFORCE_WORKER_ENABLED=false
# Private isolated runner service; do not expose publicly or put its secret in client variables
REPOSITORY_RUNNER_URL=
RUNNER_HMAC_SECRET=
# Configure the same allowlist on the isolated runner host, not in client code
RUNNER_ALLOWED_REPOSITORIES=
PLUGIN_RUNTIME_ENABLED=false
PLUGIN_RUNTIME_TOKEN=
PLUGIN_RUNTIME_SANDBOX_ATTESTED=false
CRON_SECRET=
LEO_WEBHOOK_SECRET=

# Optional contact, analytics, and monitoring
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
OWNER_EMAIL=leonardudoh5@gmail.com
WHATSAPP_ADMIN_TO=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional Google PageSpeed Insights API key for more reliable mobile/desktop Lighthouse audits.
PAGESPEED_INSIGHTS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional usage accounting estimates (USD per million tokens)
AI_INPUT_USD_PER_1M_TOKENS=
AI_OUTPUT_USD_PER_1M_TOKENS=

# Optional staging/load-test settings. Do not point load tests at production.
LEONARDX_STAGING_URL=
LEONARDX_ALLOW_STAGING_LOAD=false
LEONARDX_LOAD_CONCURRENCY=2
LEONARDX_LOAD_SECONDS=10
# Use localhost for local development; set the deployed URL in Vercel project environment variables.
LEONARDX_BASE_URL=http://localhost:3000
LEONARDX_API_MODELS=
LEONARDX_URL=http://localhost:3000
LEO_HOSTING_ENFORCEMENT=false
HOSTING_RENEWAL_AMOUNT_KOBO=
HOSTING_TRIAL_DAYS=

# Workforce durability: enable only after applying migrations and deploying a protected scheduler.
# The worker is called with Authorization: Bearer $CRON_SECRET; never expose it to clients.
